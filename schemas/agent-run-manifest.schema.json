{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engineering-harness/agent-run-manifest.schema.json",
  "title": "Engineering Harness Fresh Agent Run Manifest",
  "type": "object",
  "required": [
    "schema_version", "run_id", "case_id", "role", "started_at",
    "finished_at", "authority", "prohibited_inputs", "prompt_sha256",
    "input_tree_sha256", "baseline_commit", "model_limitation",
    "response_sha256", "diff_before_sha256", "diff_after_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["implementer", "validator", "escalation", "auditor", "red-team"]},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "prohibited_inputs": {"type": "array", "items": {"type": "string"}},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "model_limitation": {"type": "string", "minLength": 1},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diff_before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diff_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
