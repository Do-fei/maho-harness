{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engineering-harness/project.schema.json",
  "title": "Engineering Harness Project Configuration",
  "type": "object",
  "required": ["schema_version", "project_name", "checks", "proposed_checks", "protected_paths", "generated_paths", "runtime_probes", "selected_stack_packs"],
  "properties": {
    "schema_version": {"const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "default": "."},
          "required": {"type": "boolean", "default": true},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        },
        "additionalProperties": false
      }
    },
    "proposed_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "default": "."},
          "required": {"type": "boolean", "default": true},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "evidence": {"type": "string", "minLength": 1},
          "stack_pack": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "protected_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "generated_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "stack_packs", "status"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "stack_packs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["PROPOSED", "ACCEPTED", "PASS", "FAIL", "INCONCLUSIVE"]}
        },
        "additionalProperties": false
      }
    },
    "selected_stack_packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "guidance", "runtime_probe_types", "references", "conflicts"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "version": {"type": "integer", "minimum": 1},
          "guidance": {"type": "string", "minLength": 1},
          "runtime_probe_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "references": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
